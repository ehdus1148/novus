# Server environment example
PORT=3001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001
TARGET_AMOUNT=100000000

# KakaoPay
# Admin Key from Kakao Developers -> KakaoPay
KAKAO_ADMIN_KEY=
